# Host port for the web application.
AXIOM_PORT=3000

# Directory whose top-level CSV files Axiom should discover. Uploads work independently.
AXIOM_INPUT_DIR=.

# Maximum upload size in bytes (100 MiB by default).
AXIOM_MAX_UPLOAD_BYTES=104857600

# Enable these for the private dashboard deployment.
AXIOM_REQUIRE_AUTH=false
AXIOM_SUPABASE_URL=
AXIOM_SUPABASE_ANON_KEY=
AXIOM_OWNER_ID=
AXIOM_WORKER_SECRET=
AXIOM_BUILD_REVISION=development
AXIOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
